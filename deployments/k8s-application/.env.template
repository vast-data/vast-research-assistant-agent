# Agent Configuration
AGENT_TEMPERATURE=0.15
AGENT_MARKDOWN=true
AGENT_NAME=ResearchAssistant

# RAG Backend Configuration
RAG_BASE_URL=http://backend-webserver.research-assistant:8080
RAG_SSL_VERIFY=false
RAG_TIMEOUT=60.0

# VastDB Configuration
VASTDB_ENDPOINT=
VASTDB_ACCESS_KEY=
VASTDB_SECRET_KEY=
# Optional overrides (preferred when Insight Engine bucket/schema differ from
# the K8s namespace derived from RAG_BASE_URL). If unset, defaults to
# <namespace>-bucket / <namespace>-schema.
# Example for ie-collections / Insight Engine:
# VASTDB_BUCKET=collections-tn-bucket
# VASTDB_SCHEMA=collections-schema
VASTDB_BUCKET=
VASTDB_SCHEMA=
# Optional: IE chunks schema when sessions use a different VASTDB_SCHEMA
# (defaults to <namespace>-schema from RAG_BASE_URL, e.g. insight-engine-schema)
# VASTDB_COLLECTIONS_BUCKET=
# VASTDB_COLLECTIONS_SCHEMA=

# API Configuration
API_TITLE=Research Assistant API
API_DESCRIPTION=API for research assistant with RAG backend integration
API_VERSION=1.0.0

# Model Provider: "nvidia" | "gemini" | "vertex"
#   nvidia  - OpenAI-compatible API (NVIDIA NIM, local vLLM, NVIDIA cloud, or Azure Foundry)
#   gemini  - Google AI Studio (uses API key)
#   vertex  - Google Vertex AI (uses service account / ADC credentials)
MODEL_PROVIDER=nvidia
# GUI header badge (optional). Keep MODEL_PROVIDER=nvidia for OpenAIChat routing.
# MODEL_PROVIDER_DISPLAY=Microsoft Foundry

# OpenAI/NVIDIA Configuration (used when MODEL_PROVIDER=nvidia)
AGENT_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# llama-3.3-70b-instruct is EOL on Integrate (410). Default to Nemotron nano.
# Backend sets chat_template_kwargs.enable_thinking=false for nemotron models.
# For Azure Foundry, set AGENT_OPENAI_BASE_URL to .../openai/v1 and e.g. gpt-5.4-mini.
AGENT_OPENAI_MODEL_ID=nvidia/nemotron-3-nano-30b-a3b
AGENT_OPENAI_API_KEY=

# RAG retrieve / agent tool behavior
# IE without a reranker returns 500 when with_rerank=true
RETRIEVE_WITH_RERANK=false
# Off by default: weak models often emit tool-call JSON as the final answer
ENABLE_REASONING_TOOLS=false
# Extra LLM call for session titles; default off (Foundry RPM)
GENERATE_SESSION_TITLE_WITH_LLM=false
# Optional client spacing for low-RPM Foundry (e.g. 7 for ~10 RPM); 0 = off
FOUNDRY_MIN_INTERVAL_SEC=0

# Google AI Studio Configuration (used when MODEL_PROVIDER=gemini)
GEMINI_MODEL_ID=gemini-2.5-pro
GOOGLE_API_KEY=

# Google Vertex AI Configuration (used when MODEL_PROVIDER=vertex)
# Requires GOOGLE_APPLICATION_CREDENTIALS env var pointing to service account JSON,
# or Application Default Credentials (gcloud auth application-default login)
VERTEX_MODEL_ID=gemini-2.5-pro
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Azure AD Configuration (optional)
AUTH__AZURE__CLIENTID=
AUTH__AZURE__CLIENTSECRET=
AUTH__AZURE__NEXTAUTHSECRET=
AUTH__AZURE__AUTHORIZATIONENDPOINT=
AUTH__AZURE__TOKENENDPOINT=
AUTH__AZURE__ISSUERENDPOINT=
AUTH__AZURE__JWKSENDPOINT=
AUTH__AZURE__REDIRECTURI=
AUTH__AZURE__NEXTAUTHURL=

# GSF (Generative SQL Foundation) — optional structured DB queries
# The UI GSF toggle registers query_database only when GSF_BASE_URL is set (e.g. http://<gsf-host>:3001).
GSF_BASE_URL=
GSF_API_KEY=
# Must match a database name configured in GSF (e.g. gsf-bucket)
GSF_TARGET_DB=

# CrowdStrike AIDR — dual gate: CS_AIDR_ENABLED env AND per-request aidr_enabled (UI default OFF)
CS_AIDR_ENABLED=false
CS_AIDR_BASE_URL=
CS_AIDR_TOKEN=
CS_AIDR_APP_ID=research-assistant
